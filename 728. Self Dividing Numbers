class Solution {
public:
    vector<int> selfDividingNumbers(int left, int right) {
        vector<int>ans;
        for(int i=left;i<=right;i++){
            int org=i;
            int temp=i;
            bool self=true;
            while(temp>0){
                int digit=temp%10;
                if (digit==0) {
                    self=false;
                    break;
                }
                if(digit!=0 && org%digit!=0){
                    self=false;
                    break;
                }
                temp=temp/10;
            }
            if(self)
                    ans.push_back(org);
        }
        return ans;
    }
};
