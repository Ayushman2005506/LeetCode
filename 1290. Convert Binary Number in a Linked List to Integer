class Solution {
public:
    int getDecimalValue(ListNode* head) {
        vector<int>ans;
        ListNode* temp=head;
        while(temp!=nullptr){
            ans.push_back(temp->val);
            temp=temp->next;
        }
        int res=0;
        int mul=1;
        for(int i=ans.size()-1;i>=0;i--){
            res+=ans[i]*mul;
            mul*=2;
        }
        return res;
    }
};
