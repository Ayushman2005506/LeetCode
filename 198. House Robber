class Solution {
public:
    int rob(vector<int>& nums) {
        if(nums.size()==1){
            return nums[0];
        }
        if(nums.size()==2){
            return max(nums[0],nums[1]);
        }
        int curr=0;
        int prev1=max(nums[0],nums[1]);
        int prev2=nums[0];
        for(int i=2;i<nums.size();i++){
            curr=max(prev1,nums[i]+prev2);
            prev2=prev1;
            prev1=curr;
        }
        return curr;
    }
};
