class Solution {
public:
    long long maxArrayValue(vector<int>& nums) {
        if(nums.size()==1){
            return nums[0];
        }
        long long ans=0;
        long long current=nums.back();
        for(int i=nums.size()-2;i>=0;i--){
            if(nums[i]<=current){
                current+=nums[i];
                ans=max(ans, current);
            }
            else{
                current=nums[i];
                ans=max(ans, current);
            }
        }
        return ans;
    }
};
