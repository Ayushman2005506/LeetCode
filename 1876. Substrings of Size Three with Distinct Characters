class Solution {
public:
    int countGoodSubstrings(string s) {
        unordered_map<char,int>freq;
        int n=s.length();
        int l=0;
        int r=0;
        int count=0;
        while(r<n){
            freq[s[r]]++;
            if(r-l+1>3){
                freq[s[l]]--;
                if(freq[s[l]]==0){
                    freq.erase(s[l]);
                }
                l++;
            }
            if(r-l+1==3){
                if(freq.size()==3){
                    count++;
                }
            }
            r++;
        }
        return count;
    }
};
