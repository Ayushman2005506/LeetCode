class Solution {
public:
    string frequencySort(string s) {
        unordered_map<char,int>freq;
        vector<pair<char,int>>ans;
        string result="";
        for(char c:s){
            freq[c]++;
        }
        for(auto x:freq){
            ans.push_back({x.first,x.second});
        }
        for(int i=0;i<ans.size();i++){
            for(int j=0;j<ans.size()-i-1;j++){
                if(ans[j].second<ans[j+1].second){
                    swap(ans[j],ans[j+1]);
                }
            }
        }
        for(int i=0;i<ans.size();i++){
            for(int j=0;j<ans[i].second;j++){
                result+=ans[i].first;
            }
        }
        return result;
    }
};
