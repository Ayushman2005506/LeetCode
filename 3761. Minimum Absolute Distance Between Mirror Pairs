class Solution {
public:
    int reverse(int n){
            int rev=0;
            while(n>0){
                int digit=n%10;
                rev=rev*10+digit;
                n=n/10;
            }
            return rev;
        }
    int minMirrorPairDistance(vector<int>& nums) {
        map<int,int>m;
        int ans=INT_MAX;
        for(int i=0;i<nums.size();i++){
            if(m.find(nums[i])!=m.end()){
                ans=min(ans,abs(i-m[nums[i]]));
            }
            m[reverse(nums[i])]=i;
        }
        if(ans==INT_MAX){
            return -1;
        }
        return ans;
    }
};
