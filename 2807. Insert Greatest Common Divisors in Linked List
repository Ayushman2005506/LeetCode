class Solution {
public:
    ListNode* insertGreatestCommonDivisors(ListNode* head) {
        ListNode* temp=head;
        while(temp->next!=nullptr){
            ListNode* a=temp->next;
            int n=gcd(temp->val,temp->next->val);
            ListNode* newNode=new ListNode(n);
            newNode->next=temp->next;
            temp->next=newNode;
            temp=a;
        }
        return head;
    }
};
