class Solution {
public:
    bool isNStraightHand(vector<int>& hand, int groupSize) {
        unordered_map<int,int>freq;
        int n=hand.size();
        if(n%groupSize!=0){
            return false;
        }
        sort(hand.begin(),hand.end());
        for(int i=0;i<n;i++){
            freq[hand[i]]++;
        }
        for(int i=0;i<n;i++){
            int num=hand[i];
            if(freq[num]==0){
                continue;
            }
            for(int j=0;j<groupSize;j++){
                if(freq.count(num+j) && freq[num+j]>0){
                    freq[num+j]--;
                }
                else{
                    return false;
                }
            }
        }
        return true;
    }
};
