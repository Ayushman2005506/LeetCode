class Solution {
public:
    void dfs(int i,int j,vector<vector<int>>&grid,vector<vector<bool>>& visited,bool &closed) {
        visited[i][j] = true;
        if(j+1<grid[i].size() &&grid[i][j+1]==0 &&visited[i][j+1]==false){
            dfs(i, j+1, grid, visited,closed);
        }
        if(j-1>=0 &&grid[i][j-1]==0 &&visited[i][j-1]==false){
            dfs(i, j-1, grid, visited,closed);
        }
        if(i+1<grid.size() &&grid[i+1][j]==0 &&visited[i+1][j]==false){
            dfs(i+1, j, grid, visited,closed);
        }
        if(i-1>=0 &&grid[i-1][j]==0 &&visited[i-1][j]==false){
            dfs(i-1, j, grid, visited,closed);
        }
        if(i==0 || j==0 || i==grid.size()-1 || j==grid[0].size()-1){
            closed=false;
        }
    }
    int closedIsland(vector<vector<int>>& grid) {
        vector<vector<bool>> visited(grid.size(), vector<bool>(grid[0].size(), false));
        int ans=0;
        for(int i=0;i<grid.size();i++){
            for(int j=0;j<grid[i].size();j++){
                if(grid[i][j]==0 && visited[i][j]==false){
                    bool closed=true;
                    dfs(i,j,grid,visited,closed);
                    if(closed){
                    ans++;
                    }
                }
            }
        }
        return ans;
    }
};
