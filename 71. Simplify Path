class Solution {
public:
    string simplifyPath(string path) {
        stack<string>s;
        string temp="";
        for(char c:path){
            if(c!='/'){
                temp+=c;
            }
            else{
                if(temp=="" || temp=="."){
                    
                }
                else if(temp==".."){
                    if(!s.empty()){
                    s.pop();
                    }
                }
                else{
                    s.push(temp);
                }
                temp="";
            }
        }
        if(temp==".."){
            if(!s.empty()){
                s.pop();
            }
        }       
        else if(temp!="" && temp!="."){
            s.push(temp);
        }
        vector<string>a;
        while(!s.empty()){
            a.push_back(s.top());
            s.pop();
        }
        string ans="";
        for(int i=a.size()-1;i>=0;i--){
            ans+="/";
            ans+=a[i];
        }
        if(ans==""){
            return "/";
        }
        return ans;
    }
};
        
