class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        vector<int>ans;
        int mn=INT_MAX;
        int mx=0;
        for(int i=0;i<nums.size();i++){
            if(nums[i]<mn){
                mn=nums[i];
            }
            if(nums[i]>mx){
                mx=nums[i];
            }
        }
        unordered_map<int,int>freq;
        for(int i=0;i<nums.size();i++){
            freq[nums[i]]++;
        }
        for(int i=mn;i<=mx;i++){
            if(freq[i]==0){
                ans.push_back(i);
            }
        }
        return ans;
    }
};
