class Solution {
public:
    bool checkOverlap(int radius, int xCenter, int yCenter, int x1, int y1, int x2, int y2) {
        int p1=0;
        int p2=0;
        if(xCenter<x1){
            p1=x1;
        }
        else if(xCenter>x2){
            p1=x2;
        }
        else{
            p1=xCenter;
        }
        if(yCenter<y1){
            p2=y1;
        }
        else if(yCenter>y2){
            p2=y2;
        }
        else{
            p2=yCenter;
        }
        int a=(xCenter-p1)*(xCenter-p1)+(yCenter-p2)*(yCenter-p2);
        if(a<=(radius*radius)){
            return true;
        }
        return false;
    }
};
