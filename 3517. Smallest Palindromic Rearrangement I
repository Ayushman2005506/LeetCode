class Solution {
public:
    string smallestPalindrome(string s) {
        unordered_map<char,int>freq;
        for(char c:s){
            freq[c]++;
        }
        string c="";
        for(auto x:freq){
            if(x.second%2 !=0){
                c=x.first;
                freq[x.first]--;
                break;
            }
        }
        string left="";
        for(char a='a'; a<='z';a++){
            if(freq.count(a)){
                for(int i=0;i<(freq[a]/2);i++){
                    left+=a;
                }
            }
        }
        string right="";
        for(int i=left.size()-1;i>=0;i--){
            right+=left[i];
        }
        string ans=left+c+right;
        return ans;
    }
};
