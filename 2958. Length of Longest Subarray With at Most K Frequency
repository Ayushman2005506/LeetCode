class Solution {
public:
    int maxSubarrayLength(vector<int>& nums, int k) {
        int n=nums.size();
        int l=0;
        int r=0;
        unordered_map<int,int>freq;
        int ans=0;
        while(r<n){
            freq[nums[r]]++;
            while(freq[nums[r]]>k){
                freq[nums[l]]--;
                l++;
            }
            int len=r-l+1;
            ans=max(ans,len);
            r++;
        }
        return ans;
    }
};
