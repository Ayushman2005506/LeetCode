class Solution {
public:
    int hIndex(vector<int>& citations) {
        int ans=0;
        int n=citations.size();
        for(int i=1;i<=n;i++){
            int count=0;
            for(int j=0;j<n;j++){
                if(citations[j]>=i){
                    count++;
                }
            }
            if(count>=i){
                ans=max(ans,i);
            }
        }
        return ans;
    }
};
