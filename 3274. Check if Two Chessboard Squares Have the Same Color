class Solution {
public:
    bool checkTwoChessboards(string coordinate1, string coordinate2) {
        int a=0;
        int b=0;
        int a1=coordinate1[0]-'a';
        int a2=coordinate1[1]-'0';
        a=a1+a2;
        int b1=coordinate2[0]-'a';
        int b2=coordinate2[1]-'0';
        b=b1+b2;
        if((a%2==0 && b%2==0) || (a%2!=0 && b%2!=0)){
            return true;
        }
        return false;
    }
};
