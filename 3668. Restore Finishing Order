class Solution {
public:
    vector<int> recoverOrder(vector<int>& order, vector<int>& friends) {
        vector<int>ans;
        unordered_map<int,int>freq;
        for(int i=0;i<friends.size();i++){
            freq[friends[i]]++;
        }
        for(int i=0;i<order.size();i++){
            if(freq.find(order[i])!=freq.end()){
                ans.push_back(order[i]);
            }
        }
        return ans;
    }
};
