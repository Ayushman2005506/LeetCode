class Solution {
public:
    vector<string> simplifiedFractions(int n) {
        vector<string>ans;
        for(int i=1;i<=n;i++){
            for(int j=i+1;j<=n;j++){
                if(gcd(i,j)==1){
                    string fraction="";
                    fraction+=to_string(i);
                    fraction+='/';
                    fraction+=to_string(j);
                    ans.push_back(fraction);
                }
            }
        }
        return ans;
    }
};
