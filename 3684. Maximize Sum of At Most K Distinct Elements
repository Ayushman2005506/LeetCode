class Solution {
public:
    vector<int> maxKDistinct(vector<int>& nums, int k) {
        set<int>s;
        for(int x:nums){
            s.insert(x);
        }
        vector<int>a;
        for(int x:s){
            a.push_back(x);
        }
        vector<int>ans;
        int n=a.size();
        int x=min(k,n);
        if(x>0){
            for(int i=n-1;i>=n-x;i--){
                ans.push_back(a[i]);
            }
        }
        return ans;
    }
};
