class Solution {
public:
    int lengthOfLastWord(string s) {
        int i=s.size()-1;
        while(i>=0 && s[i]==' '){
            i--;
        }
        int count=0;
        for(int j=i;j>=0;j--){
            if(s[j]!=' '){
                count++;
            }
            if(s[j]==' '){
                break;
            }
        }
        return count;
    }
};
