class Solution {
public:
    int longestSubarray(vector<int>& nums) {
        int length=2;
        int ans=2;
        for(int i=2;i<nums.size();i++){
            if(nums[i]==nums[i-1]+nums[i-2]){
                length++;
                ans=max(ans,length);
            }
            else{
                length=2;
            }
        }
        return ans;
    }
};
