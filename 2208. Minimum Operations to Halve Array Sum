class Solution {
public:
    int halveArray(vector<int>& nums) {
        int ans=0;
        double sum=0;
        for(int x:nums){
            sum+=x;
        }
        priority_queue<double> pq;
        for(int x:nums){
            pq.push(x);
        }
        double currentSum=0;
        while(currentSum<sum/2){
            double currTop=pq.top();
            pq.pop();
            double half=currTop/2;
            pq.push(half);
            currentSum+=half;
            ans++;
        }
        return ans;
    }
};
