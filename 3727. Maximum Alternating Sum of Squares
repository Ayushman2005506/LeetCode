class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        vector<long long>square;
        for(int x:nums){
            square.push_back(1LL*x*x);
        }
        sort(square.begin(),square.end());
        long long ans=0;
        for(int i=0;i<nums.size();i++){
           if(i<nums.size()/2){
            ans-=square[i];
           } 
           else{
            ans+=square[i];
           }
        }
        return ans;
    }
};
