class Solution {
    public:
    ListNode* rotateRight(ListNode* head, int k) {
        int len=1;
        ListNode* tail=head;
        if(head==nullptr){
            return nullptr;
        }
        while(tail->next!=nullptr){
            len++;
            tail=tail->next;
        }
        if(k%len==0){
            return head;
        }
        k=k%len;
        tail->next=head;
        ListNode* newLast=head;
        for(int i=1;i<len-k;i++){
            newLast=newLast->next;
        }
        head=newLast->next;
        newLast->next=nullptr;
        return head;
    }
};
