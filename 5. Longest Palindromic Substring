class Solution {
public:
    string longestPalindrome(string s) {
        string a="";
        a+='#';
        for(int i=0;i<s.length();i++){
            a+=s[i];
            a+='#';
        }
        vector<int>p(2*s.length()+1,0);
        for(int i=1;i<p.size();i++){
            int count=0;
            while(i-count-1 >=0 && i+count+1<a.size() &&a[i-count-1]==a[i+count+1]){
                count++;
            }
            p[i]=count;
        }
        int l=0;
        int c=0;
        for(int i=0;i<p.size();i++){
            if(p[i]>l){
                l=p[i];
                c=i;
            }
        }
        return s.substr((c-l)/2,l);
    }
};
