class Solution {
public:
    int triangularSum(vector<int>& nums) {
        vector<int> temp=nums;
        vector<int>ans;
        while(temp.size()>1){
            ans.clear();
        for(int i=0;i<temp.size()-1;i++){
            ans.push_back((temp[i]+temp[i+1])%10);
        }
        temp=ans;
        }
        return temp[0];
    }
};
