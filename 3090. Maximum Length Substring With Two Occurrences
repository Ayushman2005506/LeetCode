class Solution {
public:
    int maximumLengthSubstring(string s){
        unordered_map<char,int>freq;
        int n=s.length();
        int l=0;
        int r=0;
        int ans=0;
        while(r<n){
            freq[s[r]]++;
            while(freq[s[r]]>2){
                freq[s[l]]--;
                l++;
            }
            int len=r-l+1;
            ans=max(ans,len);
            r++;
        }
        return ans;
    }
};
