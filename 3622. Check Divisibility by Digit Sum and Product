class Solution {
public:
    bool checkDivisibility(int n) {
        int sum=0;
        int product=1;
        int original=n;
        while(original>0){
            int digit=original%10;
            sum+=digit;
            product*=digit;
            original=original/10;
        }
        int ans=sum+product;
        if(n%ans==0){
            return true;
        }
        return false;
    }
};
