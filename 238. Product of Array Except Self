class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        vector<int>prefix;
        prefix.push_back(1);
        for(int i=1;i<nums.size();i++){
            prefix.push_back(nums[i-1]*prefix[i-1]);
        }
        int suffix=1;
        for(int i=prefix.size()-1;i>=0;i--){
            prefix[i]=prefix[i]*suffix;
            suffix*=nums[i];
        }
        return prefix;
    }
};
