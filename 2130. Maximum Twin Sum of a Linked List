class Solution {
public:
    int pairSum(ListNode* head) {
        int ans=0;
        int count=0;
        ListNode* temp=head;
        while(temp!=nullptr){
            count++;
            temp=temp->next;
        }
        ListNode* temp1=head;
        for(int i=0;i<count/2;i++){
            temp1=temp1->next;
        }
        ListNode* prev=nullptr;
        ListNode* curr=temp1;
        while(curr!=nullptr){
            ListNode* nextNode=curr->next;
            curr->next=prev;
            prev=curr;
            curr=nextNode;
        }
        for(int i=0;i<count/2;i++){
            ans=max(ans,head->val+prev->val);
            head=head->next;
            prev=prev->next;
        }
        return ans;
    }
};
