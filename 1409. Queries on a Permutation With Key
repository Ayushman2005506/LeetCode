class Solution {
public:
    vector<int> processQueries(vector<int>& queries, int m) {
        vector<int>ans;
        vector<int>result;
        for(int i=1;i<=m;i++){
            ans.push_back(i);
        }
        for(int i=0;i<queries.size();i++){
            for(int j=0;j<ans.size();j++){
                if(queries[i]==ans[j]){
                    result.push_back(j);
                    int a=ans[j];
                    for(int k=j;k>0;k--){
                        ans[k]=ans[k-1];
                    }
                    ans[0]=a;
                }
            }
        }
        return result;
    }
};
