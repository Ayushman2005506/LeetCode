class Solution {
public:
    vector<vector<int>> findPrimePairs(int n) {
        vector<bool> prime(n+1,true);
        prime[0]=false;
        prime[1]=false;
        for(int p=2;p*p<=n;p++){
            if(prime[p]==true){
                for(int i=p*p;i<=n;i+=p){
                    prime[i]=false;
                }
            }
        }
        vector<vector<int>> ans;
        for(int i=2;i<=n/2;i++){
            if(prime[i]==true && prime[n-i]==true){
                ans.push_back({i,n-i});
            }
        }
        return ans;
    }
};
