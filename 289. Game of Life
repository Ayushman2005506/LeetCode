class Solution {
public:
    void gameOfLife(vector<vector<int>>& board) {
        int m = board.size();
        int n = board[0].size();
        vector<vector<int>> next=board;
        
        for (int i=0;i<m;i++) {
            for (int j=0;j<n;j++) {
                int count=0;
                for (int x=-1;x<=1;x++) {
                    for (int y=-1;y<=1;y++) {
                        if (x == 0 && y == 0){
                            continue;
                        }
                        int ni = i + x;
                        int nj = j + y;
                        if (ni>=0 && ni<m && nj>=0 && nj<n){
                            count+=board[ni][nj];
                        }
                    }
                }
                if (board[i][j]==1) {
                    if (count<2 || count>3){
                        next[i][j] = 0;
                    }
                }
                else{
                    if(count==3){
                        next[i][j]=1;
                    }
                }
            }
        }
        board=next;
    }
};
