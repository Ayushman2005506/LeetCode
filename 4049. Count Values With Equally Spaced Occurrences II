class Solution {
public:
    int countSpecialIntegers(vector<int>& nums) {
        unordered_map<int,int>freq;
        for(int x:nums){
            freq[x]++;
        }
        unordered_map<int,vector<int>>count;
        for(int i=0;i<nums.size();i++){
            count[nums[i]].push_back(i);
        }
        int ans=0;
        for(auto x:freq){
            if(x.second>=3){
               bool special=true;
               for(int i=1;i<count[x.first].size()-1;i++){
                   if(count[x.first][i]-count[x.first][i-1]!=count[x.first][i+1]-count[x.first][i]){
                       special=false;
                       break;
                   }
               }
                if(special){
                    ans++;
                }
            }
        }
        return ans;
    }
};
