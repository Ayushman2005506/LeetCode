class Solution {
public:
    int alternateDigitSum(int n) {
        int ans=0;
        int sign=1;
        string s=to_string(n);
        for(int i=0;i<s.size();i++){
            int digit=s[i]-'0';
            ans+=sign*digit;
            sign=sign*-1;
        }
        return ans;
    }
};
       
