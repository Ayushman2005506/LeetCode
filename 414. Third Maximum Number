class Solution {
public:
    int thirdMax(vector<int>& nums) {
        set<int>s;
        for(int i=0;i<nums.size();i++){
            s.insert(nums[i]);
        }
        vector<int>ans;
        for(int x:s){
            ans.push_back(x);
        }
        int n=ans.size();
        if(n<3){
            return ans[n-1];
        }
        return ans[n-3];
    }
};
