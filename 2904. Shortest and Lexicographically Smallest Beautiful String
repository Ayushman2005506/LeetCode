class Solution {
public:
    string shortestBeautifulSubstring(string s, int k) {
        int l=0;
        int r=0;
        int n=s.length();
        int count=0; 
        int min_len=INT_MAX; 
        string ans="";   
        while(r<n){
            if(s[r]=='1'){
                count++;
            }
            if(count==k){
                  while(s[l] != '1') {
                    l++;
                }
                int len=r-l+1;
                if(len < min_len) {
                    min_len = len;
                    ans = s.substr(l, len);
                }
                else if(len == min_len) {
                    string temp = s.substr(l, len);
                if(temp < ans) {
                    ans = temp;
                    }
                }
                count--;
                l++;
            }
        r++;
        }
        return ans;
    }
};
