class Solution {
public:
    int numOfSubarrays(vector<int>& arr, int k, int threshold) {
        int ans=0;
        int l=0,r=k-1;
        int sum=0;
        for(int i=0;i<k;i++){
            sum+=arr[i];
        }
        while(r<arr.size()){
            double average=sum/k;
            if(average>=threshold){
                ans++;
            }
            sum-=arr[l];
            r++;
            l++;
            if(r<arr.size()){
            sum+=arr[r];
            }
        }
        return ans;
    }
};
