class Solution {
public:
    vector<string> stringSequence(string target) {
        vector<string>ans;
        string curr="";
        for(int i=0;i<target.size();i++){
            curr+='a';
            ans.push_back(curr);
            while(curr.back()!=target[i]){
                curr[curr.size()-1]++;
                ans.push_back(curr);
            }
        }
        return ans;
    }
};
