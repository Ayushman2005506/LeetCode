class Solution {
public:
    vector<string> buildArray(vector<int>& target, int n) {
        int a=target[target.size()-1];
        vector<string>ans;
        for(int i=1;i<=a;i++){
            if(find(target.begin(), target.end(), i)!=target.end()){
                ans.push_back("Push");
            }
            else{
                ans.push_back("Push");
                ans.push_back("Pop");
            }
        }
        return ans;
    }
};
       
