class Solution {
public:
    int countCharacters(vector<string>& words, string chars) {
        int ans=0;
        unordered_map<char,int>freq;
        for(char c:chars){
            freq[c]++;
        }
        for(int i=0;i<words.size();i++){
            unordered_map<char,int>freq1;
            for(char c:words[i]){
                freq1[c]++;
            }
            bool valid=true;
            for(auto x:freq1){
                if(freq[x.first]<x.second){
                    valid=false;
                }
            }
            if(valid){
                ans+=words[i].length();
            }
        }
        return ans;
    }
};
