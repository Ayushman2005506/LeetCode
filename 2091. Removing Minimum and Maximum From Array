class Solution {
public:
    int minimumDeletions(vector<int>& nums) {
        int n=nums.size();
        int min_index=0;
        int max_index=0;
        int min_element=nums[0];
        int max_element=nums[0];
        for(int i=0;i<nums.size();i++){
            if(nums[i]<min_element){
                min_element=nums[i];
                min_index=i;
            }
            if(nums[i]>max_element){
                max_element=nums[i];
                max_index=i;
            }
        }
        int a=min(min_index,max_index);
        int b=max(min_index,max_index);

        int a1=b+1;
        int a2=n-a;
        int a3=(a+1)+(n-b);
        int ans=min({a1,a2,a3});
        return ans;
    }
};
