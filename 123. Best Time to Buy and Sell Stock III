class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int mini=INT_MAX;
        int profit=0;
        int n=prices.size();
        vector<int>left(n,0);
        vector<int>right(n,0);
        for(int i=0;i<n;i++){
            mini=min(mini,prices[i]);
            profit=max(profit,prices[i]-mini);
            left[i]=profit;
        }
        int profit1=0;
        int maxi=0;
        for(int i=n-1;i>=0;i--){
            maxi=max(maxi,prices[i]);
            profit1=max(profit1,maxi-prices[i]);
            right[i]=profit1;
        }   
        int ans=0;
        for(int i=0;i<n;i++){
            ans=max(ans,left[i]+right[i]);
        }
        return ans;
    }
};
