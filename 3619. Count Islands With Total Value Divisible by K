class Solution {
public:
    void dfs(int i,int j,vector<vector<int>>&grid,vector<vector<bool>>& visited,long long &sum){
        visited[i][j]=true;
        sum+=grid[i][j];
        if(j+1<grid[i].size() &&grid[i][j+1]!=0 &&visited[i][j+1]==false){
            dfs(i, j+1, grid, visited,sum);
        }
        if(j-1>=0 &&grid[i][j-1]!=0 &&visited[i][j-1]==false){
            dfs(i, j-1, grid, visited,sum);
        }
        if(i+1<grid.size() &&grid[i+1][j]!=0 &&visited[i+1][j]==false){
            dfs(i+1, j, grid, visited,sum);
        }
        if(i-1>=0 &&grid[i-1][j]!=0 &&visited[i-1][j]==false){
            dfs(i-1, j, grid, visited,sum);
        }
    }
    int countIslands(vector<vector<int>>& grid, int k) {
        vector<vector<bool>> visited(grid.size(), vector<bool>(grid[0].size(), false));
        int ans=0;
        for(int i=0;i<grid.size();i++){
            for(int j=0;j<grid[0].size();j++){
                long long sum=0;
                if(grid[i][j]!=0 && visited[i][j]==false){
                    dfs(i,j,grid,visited,sum);
                    if(sum%k==0){
                        ans++;
                    }
                }
            }
        }
        return ans;
    }
};
