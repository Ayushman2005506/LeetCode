class Solution {
public:
    string clearDigits(string s) {
        stack<char>a;
        string ans="";
        for(char c:s){
            if(c>='a' && c<='z'){
                a.push(c);
            }
            else{
                a.pop();
            }
        }
        while(!a.empty()){
            ans+=a.top();
            a.pop();
        }
        reverse(ans.begin(),ans.end());
        return ans;
    }
};
