class Solution {
public:
    int countValidWords(string sentence) {
        int ans=0;
        string word="";
        for(char c:sentence){
            if(c!=' '){
                word+=c;
            }
            else{
                if(!word.empty()){
                bool valid=true;
                if(word[0]=='-'|| word[word.length()-1]=='-'){
                    valid=false;
                }
                int hyphen=0;
                for(int i=1;i<word.length()-1;i++){
                    if(word[i]=='-'){
                        hyphen++;
                        if(hyphen>1){
                            valid=false;
                        }
                        if(!(word[i-1]>='a' && word[i-1] <= 'z')||!(word[i+1]>='a' && word[i+1]<='z')){
                                valid=false;
                            }
                    }
                }
                for(char x:word){
                    if(x>='0' && x<='9'){
                        valid=false;
                    }
                }
                int punctuation=0;
                for(int i=0;i<word.length();i++){
                    if(word[i]=='!'||word[i]=='.'||word[i]==','){
                        punctuation++;
                        if(punctuation>1){
                            valid=false;
                        }
                        if(i!=word.length()-1){
                            valid=false;
                        }
                    }
                }
                if(valid){
                ans++;
                }
                word="";
                }
            }
        }
        if(!word.empty()){
            bool valid=true;
            if(word[0]=='-' || word[word.length()-1]=='-'){
                valid=false;
            }
            int hyphen=0;
            for(int i=1;i<word.length()-1;i++){
                    if(word[i]=='-'){
                        hyphen++;
                        if(hyphen>1){
                            valid=false;
                        }
                        if(!(word[i-1]>='a' && word[i-1]<='z')||!(word[i+1]>='a' && word[i+1]<='z')){
                            valid=false;
                        }
                    }
                }
                for(char x:word){
                    if(x>='0' && x<='9'){
                        valid=false;
                    }
                }
                 int punctuation=0;
                for(int i=0;i<word.length();i++){
                    if(word[i]=='!' || word[i]=='.' || word[i]==','){
                        punctuation++;
                        if(punctuation>1){
                            valid=false;
                        }
                        if(i!=word.length()-1){
                            valid=false;
                        }
                    }
                }
                if(valid){
                    ans++;
                }
        }
        return ans;
    }
};
