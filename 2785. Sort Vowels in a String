class Solution {
public:
    string sortVowels(string s) {
        vector<char>vowel;
        for(char c:s){
            if(c=='a'||c=='e'||c=='i'||c=='o'||c=='u'||c=='A'||c=='E'||c=='I'||c=='O'||c=='U'){
                vowel.push_back(c);
            }
        }
        sort(vowel.begin(),vowel.end());
        int i=0;
        for(int j=0;j<s.size();j++){
            if(s[j]=='a'||s[j]=='e'||s[j]=='i'||s[j]=='o'||s[j]=='u'||s[j]=='A'||s[j]=='E'||s[j]=='I'||s[j]=='O'||s[j]=='U'){
                s[j]=vowel[i];
                i++;
            }
        }
        return s;
    }
};
