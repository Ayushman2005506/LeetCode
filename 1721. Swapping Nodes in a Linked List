class Solution {
public:
    ListNode* swapNodes(ListNode* head, int k) {
        vector<int>ans;
        ListNode* temp=head;
        while(temp!=nullptr){
            ans.push_back(temp->val);
            temp=temp->next;
        }
        int l=0;
        int r=ans.size()-1;
        for(int i=0;i<k-1;i++){
            l++;
            r--;
        }
        swap(ans[l],ans[r]);
        ListNode* head1=new ListNode(ans[0]);
        ListNode* temp1=head1;
        for(int i=1;i<ans.size();i++){
            temp1->next= new ListNode(ans[i]);
            temp1=temp1->next;
        }
        return head1;
    }
};
