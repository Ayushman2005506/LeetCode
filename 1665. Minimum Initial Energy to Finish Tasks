class Solution {
public:
    int minimumEffort(vector<vector<int>>& tasks) {
        for(int i=0;i<tasks.size();i++){
            for(int j=i+1;j<tasks.size();j++){
                if(tasks[i][1]-tasks[i][0]<tasks[j][1]-tasks[j][0]){
                swap(tasks[i],tasks[j]);
                }
            }
        }
        int ans=0;
        int energy=0;
        for(int i=0;i<tasks.size();i++){
            if(energy<tasks[i][1]){
                int extra=tasks[i][1]-energy;
                energy+=extra;
                ans+=extra;
            }
            energy-=tasks[i][0];
        }
        return ans;
    }
};
