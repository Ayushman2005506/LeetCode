class Solution {
public:
    int minSteps(string s, string t) {
      unordered_map<char,int>freq1;
      unordered_map<char,int>freq2;
      for(int i=0;i<s.size();i++){
        freq1[s[i]]++;
      }  
      for(int i=0;i<t.size();i++){
        freq2[t[i]]++;
      }
      int ans=0;
      for(auto x:freq1){
        if(freq1[x.first]>freq2[x.first]){
            ans+=freq1[x.first]-freq2[x.first];
        }
      }
      return ans;
    }
};
