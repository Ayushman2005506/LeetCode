class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        ListNode* dummy=new ListNode();
        ListNode* temp=dummy;
        int carry=0;
        ListNode* a=l1;
        ListNode* b=l2;
        while(a!=nullptr||b!=nullptr||carry){
            int sum=carry;
            if(a!=nullptr){
                sum+=a->val;
                a=a->next;
            }
            if(b!=nullptr){
                sum+=b->val;
                b=b->next;
            }
            carry=sum/10;
            temp->next=new ListNode(sum%10);
            temp=temp->next;
        }
        return dummy->next;
    }
};
