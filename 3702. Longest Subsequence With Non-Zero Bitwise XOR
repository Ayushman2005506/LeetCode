class Solution {
public:
    int longestSubsequence(vector<int>& nums) {
        int x=0;
        for(int i=0;i<nums.size();i++){
            x^=nums[i];
        }
        if(x>0){
            return nums.size();
        }
        int ans=0;
        if(x==0){
            for(int i=0;i<nums.size();i++){
                ans^=nums[i];
                if(ans>0){
                    return nums.size()-1;
                }
            }
        }
        return 0;
    }
};
