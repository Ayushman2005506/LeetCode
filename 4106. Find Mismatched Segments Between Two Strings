class Solution {
public:
    vector<vector<string>> findMismatchedSegments(string s1, string s2) {
        vector<vector<string>>ans;
        string a="";
        string b="";
        for(int i=0;i<s1.length();i++){
            if(s1[i]!=s2[i]){
                a+=s1[i];
                b+=s2[i];
            }
            else{
                if(a!=""){
                    vector<string>c;
                    c.push_back(a);
                    c.push_back(b);
                    ans.push_back(c);
                    a="";
                    b="";
                }
            }
        }
        if(a!=""){
            vector<string> c;
            c.push_back(a);
            c.push_back(b);
            ans.push_back(c);
        }
        return ans;
    }
};
