class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {
        unordered_map<int,int>freq;
        int n=nums.size();
        for(int i=0;i<nums.size();i++){
            freq[nums[i]]++;
        }
        if(k==1){
        int ans=-1;
        for(auto x:freq){
            if(x.second==1){
                ans=max(ans,x.first);
            }
        }
        return ans;
        }
        else if(k==n){
            int ans=0;
            for(int i=0;i<n;i++){
                ans=max(ans,nums[i]);
            }
            return ans;
        }
        else{
            int ans=-1;
            bool first=freq[nums[0]]==1;
            bool last=freq[nums[n-1]]==1;
            if(first && last){
                ans=max(nums[0],nums[n-1]);
            }
            else if(first){
                ans=nums[0];
            }
            else if(last){
                ans=nums[n-1];
            }
            return ans;
        }
        return -1;
    }
};
