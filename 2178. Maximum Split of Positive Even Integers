class Solution {
public:
    vector<long long> maximumEvenSplit(long long finalSum) {
        vector<long long>ans;
        long long a=2;
        if(finalSum%2!=0){
            return ans;
        }
        else{
            while(a<=finalSum){
                finalSum-=a;
                ans.push_back(a);
                a+=2;
            }
        }
        if(finalSum>0){
            ans.back()+=finalSum;
        }
        return ans;
    }
};
