class Solution {
public:
    map<string,string>mp;
    int cnt=0;
    string encode(string longUrl) {
        string shortUrl="http://tinyurl.com/"+to_string(cnt);
        cnt++;
        mp[shortUrl]=longUrl;
        return shortUrl;
    }

    string decode(string shortUrl) {
        return mp[shortUrl];
    }
};
