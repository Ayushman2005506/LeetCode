class Solution {
public:
    long long minimumCost(int cost1, int cost2, int costBoth, int need1, int need2) {
        long long mn=min(need1,need2);
        long long mx=max(need1,need2);
        long long cost;
        if(need1>need2){
            cost=cost1;
        }
        else{
            cost=cost2;
        }
        long long ans1=mn*costBoth+(mx-mn)*cost;
        long long ans2=mx*costBoth;
        long long ans3=1LL*need1*cost1+1LL*need2*cost2;

        return min({ans1, ans2, ans3});
    }
};
