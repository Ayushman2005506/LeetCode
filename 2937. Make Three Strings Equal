class Solution {
public:
    int findMinimumOperations(string s1, string s2, string s3) {
        int n=min(s1.length(),min(s2.length(),s3.length()));
        int count=0;
        for(int i=0;i<n;i++){
            if(s1[i]==s2[i] && s2[i]==s3[i]){
                count++;
            }
            else{
                break;
            }
        }
        if(count==0){
            return -1;
        }
        else{
            int ans=0;
            ans+=(s1.length() - count)+(s2.length() - count)+(s3.length() - count);
            return ans;
        }
    }
};
