class Solution {
public:
    string reverseWords(string s) {
        string ans="";
        string word="";
        for(int i=s.length()-1;i>=0;i--){
            if(s[i]!=' '){
                word+=s[i];
            }
            if(!word.empty() && s[i]==' '){
                reverse(word.begin(),word.end());
                if(!ans.empty()){
                ans+=' ';
                }
                ans+=word;
                word="";
            }
        }
        reverse(word.begin(),word.end());
        if(!word.empty()){
            if(!ans.empty()){
                ans+=' ';
            }
        }
        ans+=word;
        return ans;
    }
};
